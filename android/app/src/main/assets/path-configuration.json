{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/worth",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["/new$", "/edit$", "^/sign_in$", "^/sign_up$", "^/imports/[0-9]+$"],
      "properties": { "pull_to_refresh_enabled": false }
    }
  ]
}
